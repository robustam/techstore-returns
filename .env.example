# ============================================================
# TechStore Returns — variables de entorno
# Copia este archivo como .env y completa los valores.
#   cp .env.example .env
# NUNCA subas .env al repositorio (está en .gitignore).
# ============================================================

# ---------- API Key de Gemini (rama LLM opcional) ----------
# Obtén una gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# ---------- Rutas (opcionales, valores por defecto) ----------
DB_PATH=techstore.db
CHROMA_PATH=./chroma_db
EVIDENCE_DIR=./evidence

# ---------- Modelo LLM (opcional, valor por defecto) ----------
GEMINI_MODEL=gemini-1.5-flash

# ---------- Streamlit (opcional) ----------
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true